module renderer;

_ :: #import compile;
_ :: #import gl;
_ :: #import misc;
_ :: #import math;

//            SCREEN SPACE
/* (0, 5.625) ----------------- (10, 5.625)
 *            |               |
 *            |               |
 *            |               |
 *            |               |
 * (0, 0)     ----------------- (10, 0)
 */

Filter :: enum {
	Nearest,
	Linear,
}

SHADER_COUNT :: 2;
Shader :: enum {
	Box,
	Line,
}

Renderer :: struct {
	white: GPUTexture,
	vao: GPUBuffer,
	vbo: GPUBuffer,
	ebo: GPUBuffer,
	shader: u32,
	width: u32,
	height: u32,
	shaders: [SHADER_COUNT]u32,
};

make_renderer :: fn(w: u32, h: u32) -> (Renderer, bool) {
	//gl.Enable(gl.DEPTH_TEST);  
	gl.Enable(gl.CULL_FACE);
	gl.Enable(gl.BLEND);
	gl.Enable(gl.SCISSOR_TEST);
	//gl.CullFace(GL_BACK);
	//gl.FrontFace(GL_CCW);
	gl.BlendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

	r: Renderer;
	using r;
	shader = -1;
	vao = gl.CreateVertexArray();
	vbo = gl.CreateBuffer();
	ebo = gl.CreateBuffer();
	
	VERT_2D :: #embed_str "../shaders/2d.vert";
	BOX_2D :: #embed_str "../shaders/box.frag";
	LINE_VERT :: #embed_str "../shaders/line.vert";
	LINE_FRAG :: #embed_str "../shaders/line.frag";
	shaders[Shader.Box as int]  = compile_shader_program(VERT_2D, BOX_2D);
	shaders[Shader.Line as int] = compile_shader_program(LINE_VERT, LINE_FRAG);
	for it in shaders {
		if it == 0
			return .{}, false;
	}
	set_shader(&r, Shader.Box);

	white_data: u32 = 0xFFFFFFFF;
	white = create_texture((&white_data) as *u8, 1, 1, .Nearest);

	resize_screen(&r, w, h);

	return r, true;
}

set_depth_test :: fn(b: bool) {
	if b
		gl.Enable(gl.DEPTH_TEST);
	else
		gl.Disable(gl.DEPTH_TEST);
}

set_shader :: fn(r: *Renderer, shader: Shader) {
	if r.shader != r.shaders[shader as int] {
		r.shader = r.shaders[shader as int];
		gl.UseProgram(r.shader);
	}
}

resize_screen :: fn(r: *Renderer, w: u32, h: u32) {
	r.width = w;
	r.height = h;
	gl.Viewport(0, 0, w as i32, h as i32);
}

upload_texture :: fn(pixels: *u8, width: u32, height: u32, filter: Filter, tex: GPUTexture) {
	gl.BindTexture(gl.TEXTURE_2D, tex);

	fl_min := gl.LINEAR_MIPMAP_LINEAR;
	fl_mag := gl.LINEAR;
	if filter == .Nearest {
		fl_min = gl.NEAREST_MIPMAP_NEAREST;
		fl_mag = gl.NEAREST;
	}

	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);	
	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.REPEAT);
	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, fl_min);
	gl.TexParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, fl_mag);

	gl.TexImage2D(gl.TEXTURE_2D, 0, gl.RGBA, width as u32, height as u32, 0, gl.RGBA as u32, gl.UNSIGNED_BYTE, pixels);
	gl.GenerateMipmap(gl.TEXTURE_2D);
}

create_texture :: fn(pixels: *u8, width: u32, height: u32, filter: Filter) -> GPUTexture {
	tex := gl.CreateTexture();
	upload_texture(pixels, width, height, filter, tex);

	return tex;
}


compile_shader_program :: fn(vs_src: string, fs_src: string) -> u32 {
	vs := gl.CreateShader(gl.VERTEX_SHADER);
	fs := gl.CreateShader(gl.FRAGMENT_SHADER);
	vdata := vs_src.data;
	fdata := fs_src.data;
	gl.ShaderSource(vs, 1, &vdata, null);
	gl.ShaderSource(fs, 1, &fdata, null);
	gl.CompileShader(vs);
	gl.CompileShader(fs);

	success: i32;
	buf: [512]u8;
	gl.GetShaderiv(vs, gl.COMPILE_STATUS, &success);
	if(!success)
	{
		gl.GetShaderInfoLog(vs, 512, null, &buf[0]);
		p := (&buf[0]) as *u8;
		println("Vertex shader failed to compile!: %s", p);
		return 0;
	}

	gl.GetShaderiv(fs, gl.COMPILE_STATUS, &success);
	if(!success)
	{
		gl.GetShaderInfoLog(fs, 512, null, &buf[0]);
		p := (&buf[0]) as *u8;
		println("Fragment shader failed to compile!: %s", p);
		return 0;
	}

	program := gl.CreateProgram();
	gl.AttachShader(program, vs);
	gl.AttachShader(program, fs);
	gl.LinkProgram(program);

	gl.GetProgramiv(program, gl.LINK_STATUS, &success);
	if(!success)
	{
		gl.GetProgramInfoLog(program, 512, null, &buf[0]);
		p := (&buf[0]) as *u8;
		println("Shader failed to link!: %s", p);
		return 0;
	}

	gl.DeleteShader(vs);
	gl.DeleteShader(fs);

	return program;
}

ext_v2 :: fn(v: v2) -> v3 {
	return v3 { v[0], v[1], 0 };
}

v2_tex :: fn(v: v2) -> [2]f32 {
	return .{v[0], v[1]};
}

draw_line :: fn(r: *Renderer, from: v2, to: v2) {
	glfrom := pos_to_gl(from);
	glto := pos_to_gl(to);

	data := [4]f32{glfrom[0], glfrom[1], glto[0], glto[1]};

	gl.BindVertexArray(r.vao);
	gl.ActiveTexture(gl.TEXTURE0);
	gl.BindTexture(gl.TEXTURE_2D, r.white);
	set_uniform(r.shader, "Tex", 0 as i32);

	gl.BindBuffer(gl.ARRAY_BUFFER, r.vbo);
	gl.BufferData(gl.ARRAY_BUFFER, cast(uint, size_of data), &data[0], gl.DYNAMIC_DRAW);

	gl.VertexAttribPointer(0, 2, gl.FLOAT, gl.FALSE as u8, 2 * size_of(f32) as i32, null);
	gl.EnableVertexAttribArray(0);

	gl.DrawArrays(gl.LINES, 0, 2);
}

draw_quad :: fn(r: *Renderer, tex: u32, pos: v2, sz: v2, t_from: v2, t_to: v2) {
	glpos := pos_to_gl(pos);
	glsz := size_to_gl(sz);

	verts: [4]Vert = .{
		.{ext_v2(glpos), v2_tex(t_from)},
		.{ext_v2(glpos + v2 {glsz[0], 0}), .{t_to[0], t_from[1]}},
		.{ext_v2(glpos + glsz), v2_tex(t_to)},
		.{ext_v2(glpos + v2 {0, glsz[1]}), .{t_from[0], t_to[1]}}
	};
	draw_quad_ex(r, tex, verts);
}

gl_draw_verts :: fn(r: *Renderer, tex: u32, shader: Shader, verts: []Vert, indices: []u32) {
	_ := shader;
	verts := verts;
	indices := indices;


	gl.BindVertexArray(r.vao);
	gl.ActiveTexture(gl.TEXTURE0);
	gl.BindTexture(gl.TEXTURE_2D, tex);
	set_uniform(r.shader, "Tex", 0 as i32);

	gl.BindBuffer(gl.ARRAY_BUFFER, r.vbo);
	gl.BufferData(gl.ARRAY_BUFFER, cast(uint, size_of(Vert) * verts.count), &verts[0], gl.DYNAMIC_DRAW);

	gl.BindBuffer(gl.ELEMENT_ARRAY_BUFFER, r.ebo);
	gl.BufferData(gl.ELEMENT_ARRAY_BUFFER, cast(uint, size_of(u32) * indices.count), &indices[0], gl.DYNAMIC_DRAW);

	gl.VertexAttribPointer(0, 2, gl.FLOAT, gl.FALSE as u8, size_of(Vert) as i32, null);
	gl.EnableVertexAttribArray(0);

	gl.VertexAttribPointer(1, 2, gl.FLOAT, gl.FALSE as u8, size_of(Vert) as i32, cast(*void, size_of(v3)));
	gl.EnableVertexAttribArray(1);

	gl.DrawElements(gl.TRIANGLES, indices.count as u32, gl.UNSIGNED_INT, null);
}

draw_quad_ex :: fn(r: *Renderer, texture: u32, verts: [4]Vert) {
	verts := verts;
	gl.BindVertexArray(r.vao);

	gl.ActiveTexture(gl.TEXTURE0);
	gl.BindTexture(gl.TEXTURE_2D, texture);
	set_uniform(r.shader, "Tex", 0 as i32);

	indices: []u32 = .{
		0, 1, 2, 0, 2, 3
	};
	v := []Vert{verts[0], verts[1], verts[2], verts[3]};
	gl_draw_verts(r, texture, .Box, v, indices);
}

start_frame :: fn(r: *Renderer)  {
	v := v4{0.396, 0.067, 0.031, 1.0};
	v = v * v4{0.65, 0.65, 0.65, 0.65};

	v[3] = 1.0;
	gl.ClearColor(v[0], v[1], v[2], v[3]);
	gl.Clear(gl.COLOR_BUFFER_BIT);
	gl.Clear(gl.DEPTH_BUFFER_BIT);

	gl.UseProgram(r.shader);
}

draw_mesh :: fn(r: *Renderer, m: Mesh, texture: GPUTexture) {
	gl.BindVertexArray(r.vao);
	gl.ActiveTexture(gl.TEXTURE0);
	gl.BindTexture(gl.TEXTURE_2D, texture);
	set_uniform(r.shader, "Tex", 0 as i32);
	gl.BindBuffer(gl.ARRAY_BUFFER, m.verts);
	gl.BindBuffer(gl.ELEMENT_ARRAY_BUFFER, m.indices);

	gl.VertexAttribPointer(0, 3, gl.FLOAT, gl.FALSE as u8, size_of(Vert) as i32, null);
	gl.EnableVertexAttribArray(0);
	gl.VertexAttribPointer(1, 2, gl.FLOAT, gl.FALSE as u8, size_of(Vert) as i32, cast(*void, size_of(v3)));
	gl.EnableVertexAttribArray(1);

	gl.DrawElements(gl.TRIANGLES, m.idx_count as u32, gl.UNSIGNED_INT, null);
}

pos_to_gl :: fn(pos: v2) -> v2 #inline {
	return v2 {lerp(-1, 1, pos[0] / MAX_X), lerp(-1, 1, pos[1] / MAX_Y)};
}

size_to_gl :: fn(size: v2) -> v2 #inline {
	return v2 {size[0] / (MAX_X / 2), size[1] / (MAX_Y / 2)};
}

lerp :: fn(a: f32, b: f32, t: f32) -> f32 #inline {
	return a + (b - a) * t;
}

calc_model :: fn(translate_xyz: v3, scale_xyz: v3, rotation_q: Quat) -> M4 #inline {
	rotation := quat_to_m4(rotation_q);
	translate_m := translate(translate_xyz);
	scale_m := scale(scale_xyz);
	return mat4_mult(translate_m, mat4_mult(rotation, scale_m));
}

set_model :: fn(r: *Renderer, translate_xyz: v3, scale_xyz: v3, rotation_q: Quat) #inline {
	model := calc_model(translate_xyz, scale_xyz, rotation_q);
	set_uniform(r.shader, "Model", model);
}

set_vp :: fn(r: *Renderer, camera: *Camera) {
	//rotation := mat4_mult(rotate_z, mat4_mult(rotate_y, rotate_x));
	view := calc_view(camera);
	persp := perspective(r.width as f32 / r.height as f32, FOV);

	set_uniform(r.shader, "View", view);
	set_uniform(r.shader, "Projection", persp);
}

set_uniform :: fn(shader: u32, name: string, v: $T) {
	v := v;
	#run {
		allowed :: []type{M4, v2, v3, v4, i32, f32};
		T := type_of v;
		found := false;
		for it in allowed {
			if T == it found = true;
		}
		if !found {
			raise_error(#file_location, "Unknown type passed in set_uniform %", T);
		}
	};

	location := gl.GetUniformLocation(shader, name.data as *u8);
	if T == v2 {
		p := *cast(*v2, &v);
		gl.Uniform2f(location, p[0], p[1]);
	}
	if T == v3 {
		p := *cast(*v3, &v);
		gl.Uniform3f(location, p[0], p[1], p[2]);
	}
	if T == v4 {
		p := *cast(*v4, &v);
		gl.Uniform4f(location, p[0], p[1], p[2], p[3]);
	}
	if T == i32 {
		i := *cast(*i32, &v);
		gl.Uniform1i(location, i);
	}
	if T == f32 {
		i := *cast(*f32, &v);
		gl.Uniform1f(location, i);
	}
}

upload_vertex_buffer :: fn(data: []u8) -> GPUBuffer {
	data := data;

	buf := gl.CreateBuffer();
	gl.BindBuffer(gl.ARRAY_BUFFER, buf);
	gl.BufferData(gl.ARRAY_BUFFER, data.count as uint, &data[0], gl.STATIC_DRAW);
	return buf;
}

upload_index_buffer :: fn(data: []u8) -> GPUBuffer {
	data := data;

	buf := gl.CreateBuffer();
	gl.BindBuffer(gl.ELEMENT_ARRAY_BUFFER, buf);
	gl.BufferData(gl.ELEMENT_ARRAY_BUFFER, data.count as uint, &data[0], gl.STATIC_DRAW);
	return buf;
}

GPUBuffer :: u32;
GPUTexture :: u32;

MAX_X: f32 : 10;
MAX_Y: f32 : 5.625;

Vert :: struct {
	pos: v3,
	tex: [2]f32,
}

Mesh :: struct {
	verts: GPUBuffer,
	indices: GPUBuffer,
	idx_count: i32,
}


