		size = size,
		t00 = t00,
		t11 = t11,
		texture = texture,
	};
	cmd: DrawCommand;
	cmd.texture = tex;

	push_cmd(cmd);
}
*/

enqueue_line_command :: fn(from: iv2, to: iv2, width_px: int, col: v4) {
	line := DrawCommandLine { tag = .DrawLine, from = from, to = to, width_px = width_px, color = col };
	cmd: DrawCommand;
	cmd.line = line;

	push_cmd(cmd);
}

enqueue_box_command :: fn(bound: Bounds, color: v4) {
	box := DrawCommandBox {
		tag = .DrawBox,
		bound = bound,
		color = color,
	};
	cmd: DrawCommand;
	cmd.box = box;

	push_cmd(cmd);
}

enqueue_rndbox_command :: fn(bound: Bounds, color: v4, darken_eff: f32, top_radius: int, bot_radius: int) {
	box := DrawCommandBox {
		tag = .DrawBox,
		bound = bound,
		color = color,
		darken_eff = darken_eff,
		top_radius = top_radius,
		bot_radius = bot_radius,
	};
	cmd: DrawCommand;
	cmd.box = box;

	push_cmd(cmd);
}

enqueue_draw_text :: fn(text: string, pos: iv2, centered: bool = true, col: v4 = .{1, 1, 1, 1}, font_h: int = 20) {
	txt := DrawCommandText {
		tag = .DrawText,
		text = text,
		pos = pos,
		col = col,
		centered = centered,
		font_h = font_h,
	};
	cmd: DrawCommand;
	cmd.text = txt;

	push_cmd(cmd);
}

draw_bordered_rndbox :: fn(bound: Bounds, fg_color: v4, border_color: v4, use_darken: f32 = 0.0, top_radius: int = 13, bot_radius: int = 13, border_thickness: int = 2) {
	thck := iv2 {border_thickness, border_thickness};

	border := bound;
	bound := bound;
	bound.pos += thck;
	bound.size -= thck * .{2, 2};
	enqueue_rndbox_command(border, border_color, 0.0, top_radius, bot_radius);
	enqueue_rndbox_command(bound, fg_color, use_darken, top_radius, bot_radius);
}

set_padding :: fn(w: *Widget, padding: Inset) -> *Widget {
	w.padding = padding;
	return w;
}

set_margin :: fn(w: *Widget, margin: Inset) -> *Widget {
	w.margin = margin;
	return w;
}

is_in_box :: fn(p: v2, bl: v2, sz: v2) -> bool {
	return p[0] >= bl[0] && p[0] <= bl[0] + sz[0] &&
		p[1] >= bl[1] && p[1] <= bl[1] + sz[1];
}

measure_text :: fn(text: string, font_h: int = 20) -> v2 {
	pxsz := measure_text_px(text, font_h);
	return px_size_to_screen(pxsz);
}

config_window_size :: fn(font: *Font, sw: int, sh: int, pw: int, ph: int) {
	f = font;
	screen_width = sw;
	screen_height = sh;
	phy_width = pw;
	phy_height = ph;

	UI.window_width = sw;
	UI.window_height = sh;
	widget := _top_widget;
	if widget {
		mark_dirty(widget);
	}
}

_top_widget: ?*Widget=null;
set_top_widget :: fn(top: *Widget) {
	_top_widget = top;
}

hit_test :: fn(root: *Widget, x: int, y: int) -> ?*Widget #nocheck {
	if !widget_has_flag(root, .Visible)
		return null;

	r := root.bounds_abs;
	if x < r.pos[0] || x >= r.pos[0] + r.size[0] || y < r.pos[1] || y > r.pos[1] + r.size[1] {
		return null;
	}
	child := root.children;
	if !child {
		return root;
	}

	for child.next {
		child = child.next;
	}

	for child {
		hit := hit_test(child, x, y);
		if hit return hit;
		child = child.prev;
	}

	return root;
}

fire_event :: fn(root: *Widget, e: WidgetEvent) #nocheck {
	if !widget_has_flag(root, .Visible)
		return;

	e := e;
	e.bubbles = true; // handlers can set this to false to prevent bubbling
	w := root;
	for w {
		if w.vtable.on_event
			w.vtable.on_event(w, &e);

		if !e.bubbles
			return;
		w = w.parent;
	}
}

handle_mouse_move :: fn(mouse_abs: v2, delta: v2) {
	root := _top_widget;
	if !root
		return;

	hit := UI.captured_mouse;
	if !hit
		hit = hit_test(root, mouse_abs[0] as int, mouse_abs[1] as int);
	if hit != UI.hovered {
		hovered := UI.hovered;
		if hovered {
			hovered.flags &= ~.Hovered;
			e := WidgetEvent { tag = .MouseLeave };
			fire_event(hovered, e);
		}
		UI.hovered = hit;
		if hit {
			hit.flags |= .Hovered;
			e := WidgetEvent { tag = .MouseEnter };
			fire_event(hit, e);
		}
	}

	if hit {
		e := WidgetEvent {tag = .MouseMove};
		e.u.mousemove = .{ delta = delta };
		fire_event(hit, e);
	}
}

clear_focus :: fn() {
	focused := UI.focused;
	if focused {
		focused.flags &= ~.Focused;
		e := WidgetEvent { tag = .LoseFocus };
		fire_event(focused, e);
		stop_text_input();
		UI.focused = null;
	}
}

focus_widget :: fn(w: *Widget) {
	if !widget_has_flag(w, .Focusable)
		return;

	focused := UI.focused;
	if focused == w
		return;

	clear_focus();
	UI.focused = w;
	w.flags |= .Focused;

	e := WidgetEvent { tag = .GainFocus };
	fire_event(w, e);
}

handle_mouse_button :: fn(at_mouse: v2, button: int, is_down: bool) {
	root := _top_widget;
	if !root
		return;

	// Left or Right
	if button != 1 && button != 2
		return;

	target := UI.captured_mouse;
	if !target
		target = hit_test(root, at_mouse[0] as int, at_mouse[1] as int);

	if is_down {
		if target {
			if widget_has_flag(target, .Focusable) {
				focus_widget(target);
			} else {
				clear_focus();
			}
			if button == 1 {
				UI.captured_mouse = target;
				if target target.flags |= .Pressed;
			}
		}
	} else {
		if button == 1 {
			captured := UI.captured_mouse;
			if captured {
				captured.flags &= ~.Pressed;
			}
			UI.captured_mouse = null;
		}
	}

	if target {
		e: WidgetEvent;
		e.tag = if is_down then .MouseDown else .MouseUp;
		e.u.button.mouse_x = at_mouse[0] as int;
		e.u.button.mouse_y = at_mouse[1] as int;
		e.u.button.button = button;
		fire_event(target, e);
		
		if !is_down && widget_has_flag(target, .Enabled) {
			hit := hit_test(root, at_mouse[0] as int, at_mouse[1] as int);
			still_hovering := UI.hovered == target && hit == target;
			if still_hovering {
				e := WidgetEvent { tag = .MouseClick };
				fire_event(target, e);
			}
		}
	}
}

handle_text_input :: fn(text: string) #nocheck {
	if len(text) == 0
		return;

	focused := UI.focused;
	if focused == null
		return;

	e := WidgetEvent { tag = .TextInput };
	e.u.text.written = text;
	fire_event(focused, e);
}

handle_key_press :: fn(key: KeyCode, is_down: bool, shift: bool, ctrl: bool) {
	focused := UI.focused;
	if focused == null
		return;

	if key == .Esc {
		clear_focus();
		return;
	}
	
	e := WidgetEvent { tag = if is_down then .KeyDown else .KeyUp };
	e.u.key = .{key, shift, ctrl};
	fire_event(focused, e);
}

paint_widget :: fn(w: *Widget) #nocheck {
	if w.vtable.paint {
		w.vtable.paint(w);
	}

	w = w.children;
	for w {
		defer w = w.next;
		paint_widget(w);
	}

}

ui_update :: fn() -> []DrawCommand {
	widget := _top_widget;
	if !widget
		return .{};

	anim_tick();

	layout_measure(widget, UI.window_width, UI.window_height);
	layout_arrange(widget, .{pos = .{}, size = .{UI.window_width, UI.window_height}});
	paint_widget(widget);

	r := UI.commands.buf[:UI.commands.at];
	UI.commands.at = 0;
	UI.at_clip = 0;
	push_clip(widget.bounds_abs);

	return r;
}

