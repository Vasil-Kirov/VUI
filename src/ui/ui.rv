module ui;

_ :: #import misc;

PrimaryColor :: v4 { 0.22745098039215686, 0.5254901960784314, 1.0, 1.0 };
DarkenFactor :: 0.8;

iv2 :: [2]int;

Bounds :: struct {
	pos:  iv2,
	size: iv2,
}

MAX_CLIP_STACK :: 1024;

UIState :: struct {
	clip_stack: [MAX_CLIP_STACK]Bounds,
	at_clip: int,
	window_width: int,
	window_height: int,
	commands: CommandBuffer,
	style: ?*Style,

	hovered: ?*Widget,
	focused: ?*Widget,
	captured_mouse: ?*Widget,

	anim_head: ?*Animation,
	last_update_ms: u64,
}

UI: UIState = .{};

iv2_to_v2 :: fn(v: iv2) -> v2 {
	return .{v[0] as f32, v[1] as f32};
}

ui_clamp :: fn(x: $T, a: T, b: T) -> T {
	if x < a return a;
	if x > b return b;
	return x;
}

RGB :: fn(r: int, g: int, b: int) -> v4 {
	return .{r as f32 / 255, g as f32 / 255, b as f32 / 255, 1.0};
}

RGBA :: fn(r: int, g: int, b: int, a: int) -> v4 {
	return .{r as f32 / 255, g as f32 / 255, b as f32 / 255, a as f32 / 255};
}

color_lerp :: fn(a: v4, b: v4, t: f32) -> v4 {
    return .{
        a[0] + (b[0] - a[0]) * t,
        a[1] + (b[1] - a[1]) * t,
        a[2] + (b[2] - a[2]) * t,
        a[3] + (b[3] - a[3]) * t,
    };
}

color_darken :: fn(c: v4, amount: f32) -> v4 {
    return .{
        c[0] * (1.0 - amount),
        c[1] * (1.0 - amount),
        c[2] * (1.0 - amount),
        c[3]
    };
}

lerp :: fn(t: f32, a: f32, b: f32) -> f32 {
	return a + (b - a) * t;
}

darken :: fn(c: v4) -> v4 {
	r := c * v4{DarkenFactor, DarkenFactor, DarkenFactor, DarkenFactor};
	r[3] = c[3];
	return r;
}

CommandType :: enum: u8 {
	DrawBox,
	DrawTexture,
	DrawText,
	DrawLine,
	ClipRect,
}

DrawCommandBox :: struct {
	tag: CommandType,
	bound: Bounds,
	color: v4,
	darken_eff: f32,
	top_radius: int,
	bot_radius: int,
}

DrawCommandTexture :: struct {
	tag: CommandType,
	bound: Bounds,
	t00: v2,
	t11: v2,
	texture: GPUTexture,
}

DrawCommandText :: struct {
	tag: CommandType,
	text: string,
	pos: iv2,
	col: v4,
	centered: bool,
	font_h: int,
}

DrawCommandLine :: struct {
	tag: CommandType,
	from: iv2,
	to: iv2,
	width_px: int,
	color: v4,
}

DrawCommandClip :: struct {
	tag: CommandType,
	bounds: Bounds,
}

DrawCommand :: union {
	tag: CommandType,
	box: DrawCommandBox,
	texture: DrawCommandTexture,
	text: DrawCommandText,
	clip: DrawCommandClip,
	line: DrawCommandLine,
}

WidgetEventType :: enum: u8 {
	MouseEnter,
	MouseLeave,
	MouseMove,
	MouseDown,
	MouseUp,
	MouseClick,
	LoseFocus,
	GainFocus,
	TextInput,
	KeyDown,
	KeyUp,
	Submit,
}

KeyCode :: enum: u32 {
	Backspace,
	LeftArrow,
	RightArrow,
	Tab,
	Enter,
	Esc,
}

WidgetEventMouseMove :: struct {
	delta: v2,
}

WidgetEventMouseButton :: struct {
	mouse_x: int,
	mouse_y: int,
	button: int,
}

WidgetEventTextInput :: struct {
	written: string,
}

WidgetEventKey :: struct {
	key: KeyCode,
	shift_down: bool,
	ctrl_down: bool,
}

WidgetEvent :: struct {
	tag: WidgetEventType,
	bubbles: bool,
	u: union {
		mousemove: WidgetEventMouseMove,
		button: WidgetEventMouseButton,
		text: WidgetEventTextInput,
		key: WidgetEventKey,
	}
}

WidgetVTable :: struct {
	measure: ?*fn(*Widget, avail_w: int, avail_h: int),
	arrange: ?*fn(*Widget, bounds_abs: Bounds),
	paint:   ?*fn(*Widget),
	on_event:?*fn(*Widget, *WidgetEvent),
	destroy: ?*fn(*Widget),
	identify: *fn() -> string,
}

WidgetFlag :: enum: u32 {
	Visible = 1 << 0,
	Enabled = 1 << 1,
	Hovered = 1 << 2,
	Pressed = 1 << 3,
	Focused = 1 << 4,
	Focusable = 1 << 5,
	Selected = 1 << 6,
	ExpandW = 1 << 7,
	ExpandH = 1 << 8,
	Dirty   = 1 << 9,
}

widget_has_flag : fn(*Widget, WidgetFlag) -> bool : (w, f) -> (w.flags & f) != 0;

WIDGET_SIZE_WRAP :: -1;
WIDGET_SIZE_FILL :: -2;

Inset :: struct {
	left: int,
	right: int,
	top: int,
	bot: int,
}

Widget :: struct {
	vtable: *WidgetVTable,
	id: u32,
	flags: WidgetFlag,
	parent: ?*Widget,

	prev: ?*Widget, // siblings
	next: ?*Widget, //

	//bounds: Bounds,     // bounds relative to parent (px)
	bounds_abs: Bounds, // bounds in absolute window coords (px)

	padding: Inset,
	margin: Inset,

	desired_w: int,
	desired_h: int,

	children: ?*Widget,

	self_align: Align,
	style: ?*Style, // inherit from parent if null

	content_size: iv2,
}

CommandBuffer :: struct {
	buf: []DrawCommand,
	size: uint,
	at: uint,
}

get_style :: fn(w: *Widget) -> *Style #nocheck {
	for w {
		if w.style return w.style;
		w = w.parent;
	}
	if UI.style return UI.style;
	return &theme_dark;
}

get_content_rect :: fn(w: *Widget) -> Bounds {
	r := w.bounds_abs;
	r.pos[0] += w.padding.left;
	r.pos[1] += w.padding.top;
	r.size[0] -= w.padding.left + w.padding.right;
	r.size[1] -= w.padding.top + w.padding.bot;
	if r.size[0] < 0 r.size[0] = 0;
	if r.size[1] < 0 r.size[1] = 0;
	return r;
}

layout_arrange :: fn(w: *Widget, bounds_abs: Bounds) {
	w.bounds_abs = bounds_abs;

	if !widget_has_flag(w, .Visible)
		return;

	arrange := w.vtable.arrange;
	if arrange
		arrange(w, bounds_abs);
}

layout_measure :: fn(w: *Widget, availw: int, availh: int) {
	if !widget_has_flag(w, .Visible) {
		w.content_size = .{};
		return;
	}

	innerw := availw - w.padding.left - w.padding.right;
	innerh := availh - w.padding.top - w.padding.bot;
	if innerw < 0 innerw = 0;
	if innerh < 0 innerh = 0;

	measure := w.vtable.measure;
	if measure
		measure(w, innerw, innerh);
	
	if w.desired_w > 0 w.content_size[0] = w.desired_w - w.padding.left - w.padding.right;
	if w.desired_h > 0 w.content_size[1] = w.desired_h - w.padding.top - w.padding.bot;
}

mark_dirty :: fn(w: *Widget) #nocheck {
	for w {
		w.flags |= .Dirty;
		w = w.parent;
	}
}

make_widget :: fn(T: type, vtable: *WidgetVTable) -> *T {
	#static widget_id: u32 = 1;

	widget := memory_alloc(cast(u32, size_of T)) as *T;
	memset(widget, 0, size_of(T));
	widget.w.vtable = vtable;
	widget.w.id = widget_id++;
	widget.w.flags = .Visible | .Enabled;
	widget.w.desired_w = WIDGET_SIZE_WRAP;
	widget.w.desired_h = WIDGET_SIZE_WRAP;
	widget.w.self_align = .Default;


	return widget;
}

add_child_widget :: fn(parent: *Widget, child: *Widget) #nocheck {
	child.parent = parent;
	if !parent.children {
		parent.children = child;
		return;
	}
	n := parent.children;
	for n.next {
		n = n.next;
	}
	n.next = child;
	child.prev = n;
	mark_dirty(parent);
}

init_ui :: fn() {
	cmdp: *DrawCommand = memory_alloc(cast(u32, size_of DrawCommand) * 2048);
	UI.commands.buf = cmdp[:2048];
	UI.commands.size = 2048;
	UI.commands.at = 0;
	UI.style = &theme_dark;
}

push_cmd :: fn(cmd: DrawCommand) {
	UI.commands.buf[UI.commands.at++] = cmd;
}

get_font : fn() -> *Font : () -> f;

push_clip :: fn(bounds: Bounds) {
	if UI.at_clip >= MAX_CLIP_STACK {
		// @TODO: warning?
		return;
	}
	clip := DrawCommandClip {
		.ClipRect, bounds,
	};
	cmd: DrawCommand;
	cmd.clip = clip;

	push_cmd(cmd);

	UI.clip_stack[UI.at_clip++] = bounds;

}

pop_clip :: fn() {
	if UI.at_clip == 0
		return;

	UI.at_clip--;

	if UI.at_clip == 0
		return;

	old_clip := UI.clip_stack[UI.at_clip - 1];
	clip := DrawCommandClip {
		.ClipRect, old_clip
	};
	
	cmd: DrawCommand;
	cmd.clip = clip;
	push_cmd(cmd);
}

