        accent_pressed    : v4,
        accent_disabled   : v4,

        button_bg         : v4,
        button_bg_hover   : v4,
        button_bg_pressed : v4,
        button_fg         : v4,

        input_bg          : v4,
        input_border      : v4,
        input_border_focus: v4,
        input_selection   : v4,
        input_placeholder : v4,

