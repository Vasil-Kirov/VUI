get_ms :: fn() -> u64 {
	return sdl.GetTicks();
}

MAX_X :: 10.0;
MAX_Y :: 5.625;

px_to_screen :: fn(pos: v2) -> v2 {
	tx := pos[0] / screen_width as f32;
	ty := (screen_height as f32 - pos[1]) / screen_height as f32;
	return .{lerp(0, MAX_X, tx), lerp(0, MAX_Y, ty)};
}

px_size_to_screen_phy :: fn(size: v2) -> v2 {
	return .{
		(size[0] / phy_width  as f32) * MAX_X,
		(size[1] / phy_height as f32) * MAX_Y,
	};
}


px_size_to_screen :: fn(size: iv2) -> v2 {
	return .{
		(size[0] as f32 / screen_width  as f32) * MAX_X,
		(size[1] as f32 / screen_height as f32) * MAX_Y,
	};
}

screen_to_px :: fn(p: v2) -> v2 {
	return .{
		(p[0] / MAX_X) * screen_width as f32,
		(p[1] / MAX_Y) * screen_height as f32
	};
}

GPUTexture :: *void;
Font :: ttf.Font;

