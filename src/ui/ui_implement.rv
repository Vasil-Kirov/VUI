module ui;

#import input;
_ :: #import "libc.rv";
_ :: #import misc;
#import os;
sdl :: #import SDL;
ttf :: #import TTF;

pow :: fn(a: f32, b: f32) -> f32 {
	return powf(a, b);
}

sin ::  fn(t: f32) -> f32 {
	return sinf(t);
}

cos ::  fn(t: f32) -> f32 {
	return cosf(t);
}

memory_alloc :: fn(sz: u32) -> *void {
	p := malloc(sz as int);
	if !p {
		println("malloc(%) failed!", sz);
		os.abort();
	}
	return p;
}

memory_free :: fn(p: ?*) {
	free(p);
}

measure_text_px :: fn(text: string, font_h: int = 20) -> iv2 {
	width: i32;
	ttf.MeasureString(f, text.data, len(text) as uint, 0, &width, null);
	height := ttf.GetFontHeight(f);
	total_height := height;
	for c in text as []u8 {
		if c == '\n'
			total_height += height;
	}
	return .{width as int, total_height as int};
}

mouse_is_down :: fn() -> bool {
	return input.lmb_down;
}

mouse_went_down :: fn() -> bool {
	return input.mouse_went_down();
}

FocusHandler :: struct {
	write: ?*fn(*Widget, string),
	close: ?*fn(*Widget),
	w: ?*Widget,
	buf: [1024]u8,
	buf_used: int,
}

focus_handler: FocusHandler;

start_text_input :: fn() {
	input.start_typing();
}

stop_text_input :: fn() {
	input.stop_typing();
}

